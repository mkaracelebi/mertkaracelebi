---
import SectionHead from './SectionHead.astro';

const fields = [
  {
    n: 'A',
    title: 'AI in energy systems',
    body: 'Machine learning that respects the physics. Mert’s research uses neural ordinary differential equations to learn a grid’s dynamics from measurements while an event unfolds, fast enough for an operator to act on the forecast.',
    topics: [
      'Neural ODEs and scientific machine learning',
      'Online dynamics forecasting from local measurements',
      'ML surrogates and digital twins for dynamic security assessment',
      'Reinforcement learning for N-k contingency ranking',
      'LLM integration for custom energy system planning and analysis',
      'Mathematical optimisation',
    ],
    tools: 'PyTorch, TensorFlow, SciML, scikit-learn, Pyomo, YALMIP',
  },
  {
    n: 'B',
    title: 'Power system dynamic modelling and stability',
    body: 'Grids with less inertia and more power electronics fail in new ways. Getting the model right, and picking the right kind of study, is most of the work.',
    topics: [
      'RMS and EMT studies',
      'Frequency, rotor-angle, voltage and small-signal stability',
      'Inverter-based resources and their controls',
      'Low-inertia systems and frequency control',
      'Optimal power flow, distribution grids, multi-energy planning',
    ],
    tools: 'DIgSILENT PowerFactory, PSS Sincal, MATLAB and Simulink, MATPOWER, PowerSimulationsDynamics.jl',
  },
];
---

<section class="section" id="expertise" aria-labelledby="expertise-title">
  <div class="wrap">
    <SectionHead index="02" label="Expertise">
      <h2 id="expertise-title">Two fields, one question.</h2>
      <p>How does a modern grid behave in the seconds after a disturbance, and how do you know in time?</p>
    </SectionHead>

    <div class="fields">
      {
        fields.map((f) => (
          <article class="field">
            <p class="label letter">{f.n}</p>
            <h3>{f.title}</h3>
            <p class="body">{f.body}</p>
            <ul role="list">
              {f.topics.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <p class="tools mono">
              <span class="label">Tools</span> {f.tools}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(40px, 6vw, 96px);
  }

  .letter {
    width: 2.2em;
    height: 2.2em;
    display: grid;
    place-items: center;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    margin-bottom: 26px;
    color: var(--ink);
  }

  h3 {
    font-size: var(--step-3);
    max-width: 16ch;
  }

  .body {
    margin-top: 18px;
    color: var(--ink-muted);
    max-width: 36rem;
  }

  ul {
    list-style: none;
    margin-top: 26px;
    border-top: 1px solid var(--rule-strong);
  }

  li {
    padding: 11px 0;
    border-bottom: 1px solid var(--rule);
  }

  .tools {
    margin-top: 20px;
    color: var(--ink-muted);
    line-height: 1.7;
  }

  .tools .label {
    margin-right: 0.8em;
  }

  @media (max-width: 900px) {
    .fields {
      grid-template-columns: 1fr;
    }
  }
</style>
