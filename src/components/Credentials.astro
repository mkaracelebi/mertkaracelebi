---
const items = [
  { big: '8 years', small: 'in power systems, across academia and industrial R&D' },
  { big: 'Industry experience', small: 'business R&D in Switzerland, SCADA integration for a DSO in Turkey' },
  {
    big: '3 journal articles',
    small: 'plus a book chapter, a CIGRE paper and an IEEE PES technical report chapter on AI for grid dynamics and security',
  },
  {
    big: 'PhD at TU Delft',
    small:
      'researcher in Electrical Sustainable Energy, with the Intelligent Electrical Power Grids group and Delft AI Energy Lab; teaching assistant for Machine Learning for Electrical Engineers and MSc thesis supervisor',
  },
];
---

<section class="creds" aria-label="Track record">
  <ul class="wrap" role="list">
    {
      items.map((i) => (
        <li>
          <span class="big">{i.big}</span>
          <span class="small">{i.small}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .creds {
    border-top: 1px solid var(--rule);
    background: var(--bg-deep);
  }

  ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  li {
    padding: 26px clamp(14px, 2vw, 28px) 28px;
    border-left: 1px solid var(--rule);
    display: grid;
    gap: 8px;
    align-content: start;
  }

  li:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .big {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .small {
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    li:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }

    li:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 520px) {
    ul {
      grid-template-columns: 1fr;
    }

    li {
      border-left: 0;
      padding-left: 0;
    }

    li + li {
      border-top: 1px solid var(--rule);
    }
  }
</style>
