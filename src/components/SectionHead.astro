---
interface Props {
  index: string;
  label: string;
  id?: string;
}
const { index, label, id } = Astro.props;
---

<div class="grid head">
  <p class="label idx">
    <span class="n">{index}</span>
    <span class="slash" aria-hidden="true">/</span>
    {label}
  </p>
  <div class="title" id={id}>
    <slot />
  </div>
</div>

<style>
  .head {
    row-gap: 18px;
    margin-bottom: clamp(40px, 6vw, 80px);
  }

  .idx {
    grid-column: 1 / span 3;
    padding-top: 0.9em;
    display: flex;
    gap: 0.6em;
  }

  .n {
    color: var(--accent-ink);
  }

  .slash {
    color: var(--ink-faint);
  }

  .title {
    grid-column: 4 / -1;
  }

  .title :global(h2) {
    font-size: var(--step-4);
    max-width: 18ch;
  }

  .title :global(p) {
    margin-top: 22px;
    max-width: 40rem;
    color: var(--ink-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .idx,
    .title {
      grid-column: 1 / -1;
    }

    .idx {
      padding-top: 0;
    }
  }
</style>
