---
import { markSvg } from '../lib/mark.js';

interface Props {
  size?: 'sm' | 'lg';
}
const { size = 'sm' } = Astro.props;
const svg = markSvg({ variant: 'line', detail: 'compact', strokePx: size === 'lg' ? 1.25 : 1 });
---

<span class:list={['wordmark', size]}>
  <span class="wm-mark" set:html={svg} />
  <span class="wm-text"><span class="wm-name">Lydion</span> <span class="wm-sub">Energy</span></span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-display);
    line-height: 1;
    white-space: nowrap;
    --mark-disc: transparent;
  }

  .wm-mark {
    display: block;
    width: 1.6em;
    height: 1.6em;
    flex: none;
  }

  .wm-mark :global(svg) {
    width: 100%;
    height: 100%;
  }

  .sm {
    font-size: 1.3rem;
  }

  .lg {
    font-size: clamp(1.8rem, 1.2rem + 2vw, 2.6rem);
  }

  .wm-name {
    letter-spacing: -0.01em;
  }

  .wm-sub {
    color: var(--ink-muted);
    font-style: italic;
  }
</style>
