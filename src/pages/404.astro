---
import Base from '../layouts/Base.astro';
import { traceStreamline, toPath } from '../lib/flow.js';

// One streamline that leaves the page: the flow went somewhere you did not.
const W = 1200;
const H = 240;
const cx = 420;
const cy = 120;
const a = 46;
const G = 4 * Math.PI * a * 0.22;
const lines = [-42, -27, -12, 12, 27, 42].map((dy) =>
  toPath(traceStreamline({ x0: -20, y0: cy + dy, cx, cy, a, G, h: 3, xEnd: W + 20, maxSteps: 1400 })),
);
---

<Base title="Page not found" description="This page does not exist.">
  <section class="nf">
    <div class="wrap">
      <p class="label">404</p>
      <h1>This page has <em>drifted off</em>.</h1>
      <p class="muted">The address may be old, or mistyped. Everything else is where it was.</p>
      <p class="links">
        <a class="arrow-link" href="/">Home</a>
        <a class="arrow-link" href="/research/">Research</a>
        <a class="arrow-link" href="/#contact">Contact</a>
      </p>
    </div>
    <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
      {lines.map((d, i) => <path d={d} class={i === 1 ? 'accent' : ''} />)}
      <circle cx={cx} cy={cy} r={a - 4} />
    </svg>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(80px, 12vw, 160px) 40px;
    overflow: hidden;
  }

  h1 {
    margin-top: 18px;
    font-size: var(--step-5);
    max-width: 14ch;
  }

  h1 em {
    font-style: italic;
  }

  .muted {
    margin-top: 22px;
    max-width: 36rem;
  }

  .links {
    margin-top: 32px;
    display: flex;
    gap: 14px 28px;
    flex-wrap: wrap;
  }

  svg {
    margin-top: clamp(48px, 8vw, 96px);
    width: 100%;
    height: auto;
  }

  path {
    fill: none;
    stroke: var(--ink);
    stroke-opacity: 0.2;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  path.accent {
    stroke: var(--accent);
    stroke-opacity: 1;
  }

  circle {
    fill: none;
    stroke: var(--ink);
    stroke-opacity: 0.45;
    vector-effect: non-scaling-stroke;
  }
</style>
