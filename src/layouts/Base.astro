---
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import newsreaderUrl from '../assets/fonts/newsreader-400-opsz.woff2?url';
import newsreaderItalicUrl from '../assets/fonts/newsreader-400-opsz-italic.woff2?url';
import plexSansUrl from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
}

const { title, description = site.description, jsonLd = [], ogImage = '/og.png' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline.replace(/\.$/, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL('/#org', Astro.site).href,
  name: site.name,
  url: new URL('/', Astro.site).href,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  description: site.description,
  areaServed: 'Europe',
  address: { '@type': 'PostalAddress', addressLocality: 'Rotterdam', addressCountry: 'NL' },
  email: site.email || undefined,
  founder: {
    '@type': 'Person',
    '@id': new URL('/#mert', Astro.site).href,
    name: site.founder.name,
    alternateName: site.founder.nameAscii,
    jobTitle: 'Founder',
    affiliation: { '@type': 'CollegeOrUniversity', name: 'Delft University of Technology' },
    alumniOf: [
      { '@type': 'CollegeOrUniversity', name: 'ETH Zurich' },
      { '@type': 'CollegeOrUniversity', name: 'Middle East Technical University' },
    ],
    sameAs: [site.links.orcid, site.links.linkedin, site.links.scholar].filter(Boolean),
  },
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexSansUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#14101b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2ece1" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify([organisation, ...jsonLd])} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
